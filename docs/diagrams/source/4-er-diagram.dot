PROOF_FILES [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#333333"><TR><TD COLSPAN="4" BGCOLOR="#EFEFEF"><B>proof_files</B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555">ObjectId</FONT></TD><TD ALIGN="LEFT"><B>_id</B></TD><TD>PK</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#666666">GridFS: proofs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555">string</FONT></TD><TD ALIGN="LEFT">filename</TD><TD> </TD><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#555555">string</FONT></TD><TD ALIGN="LEFT">contentType</TD><TD> </TD><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
USERS -> CAMPAIGNS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" owns " ];
USERS -> DONATIONS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" makes " ];
CAMPAIGNS -> DONATIONS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" receives " ];
CAMPAIGNS -> COMMENTS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" has " ];
USERS -> COMMENTS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" writes " ];
USERS -> PAYOUTS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" claims " ];
PAYOUTS -> DONATIONS [dir=both, arrowtail=teeodot, arrowhead=crowtee, label=" bundles " ];
USERS -> REWARD_CLAIMS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" submits " ];
REWARD_SETTINGS -> REWARD_CLAIMS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" defines perk " ];
USERS -> UPDATES [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" sends " ];
USERS -> UPDATES [dir=both, arrowtail=crowodot, arrowhead=crowodot, label=" receives " ];
USERS -> UPDATE_STATE [dir=both, arrowtail=teetee, arrowhead=teeodot, label=" tracks reads " ];
USERS -> AUDIT_LOGS [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" acts on " ];
USERS -> PASSWORD_RESETS [dir=both, arrowtail=teetee, arrowhead=teeodot, label=" requests " ];
CAMPAIGNS -> MEDIA_FILES [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" images " ];
