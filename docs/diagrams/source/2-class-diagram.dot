digraph G {
graph [fontname="Arial", nodesep=0.5, ranksep=0.8, pad=0.3, bgcolor="white"]; node [shape=plain, fontname="Arial", fontsize=12]; edge [fontname="Arial", fontsize=11, color="#444444", labelfontsize=10];
rankdir=TB;
User [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><I>«abstract»</I><BR/><B>User</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ email: String<BR ALIGN="LEFT"/>+ name: String<BR ALIGN="LEFT"/>- password: String (hashed)<BR ALIGN="LEFT"/>+ role: String<BR ALIGN="LEFT"/>+ provider: String<BR ALIGN="LEFT"/>+ address: String<BR ALIGN="LEFT"/>+ phone_no: String<BR ALIGN="LEFT"/>+ profile_pic: String<BR ALIGN="LEFT"/>+ profile_completed: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ login()<BR ALIGN="LEFT"/>+ loginWithGoogle()<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/>+ resetPassword(otp)<BR ALIGN="LEFT"/>+ editProfile()<BR ALIGN="LEFT"/>+ viewUpdates()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
NGO [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>NGO</B></TD></TR><TR><TD ALIGN="LEFT">+ ngo_name: String<BR ALIGN="LEFT"/>+ registration_no: String<BR ALIGN="LEFT"/>+ description: String<BR ALIGN="LEFT"/>+ instagram / facebook / tiktok: String<BR ALIGN="LEFT"/>+ account_status: String<BR ALIGN="LEFT"/>+ stripe_account_id: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ createCampaign()<BR ALIGN="LEFT"/>+ publishCampaign(campaign)<BR ALIGN="LEFT"/>+ deleteCampaign(campaign)<BR ALIGN="LEFT"/>+ reviewParcel(donation, action)<BR ALIGN="LEFT"/>+ connectStripe()<BR ALIGN="LEFT"/>+ claimPayout()<BR ALIGN="LEFT"/>+ viewAnalytics()<BR ALIGN="LEFT"/>+ sendUpdate()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Admin [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Admin</B></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR><TR><TD ALIGN="LEFT">+ registerNGO()<BR ALIGN="LEFT"/>+ removeUser(user)<BR ALIGN="LEFT"/>+ viewAuditLog()<BR ALIGN="LEFT"/>+ viewAnalytics(year)<BR ALIGN="LEFT"/>+ saveRewardSettings()<BR ALIGN="LEFT"/>+ handleClaim(claim, action)<BR ALIGN="LEFT"/>+ sendAnnouncement()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Donor [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Donor</B></TD></TR><TR><TD ALIGN="LEFT">+ DOB: Date<BR ALIGN="LEFT"/>+ state: String<BR ALIGN="LEFT"/>+ membership_streak: Date<BR ALIGN="LEFT"/>+ tier: String<BR ALIGN="LEFT"/>+ total_cents: int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ donateFunds(campaign, amount)<BR ALIGN="LEFT"/>+ donateEquipment(campaign, item, qty)<BR ALIGN="LEFT"/>+ postMessage(campaign, text)<BR ALIGN="LEFT"/>+ viewDonationHistory()<BR ALIGN="LEFT"/>+ claimReward(perk)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Campaign [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Campaign</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ ngo_id: ObjectId<BR ALIGN="LEFT"/>+ title: String<BR ALIGN="LEFT"/>+ description: String<BR ALIGN="LEFT"/>+ amount_cents: int<BR ALIGN="LEFT"/>+ current_amount: int<BR ALIGN="LEFT"/>+ image_urls: List<BR ALIGN="LEFT"/>+ youtube_url: String<BR ALIGN="LEFT"/>+ needed_items: List<BR ALIGN="LEFT"/>+ keywords: List<BR ALIGN="LEFT"/>+ status: String<BR ALIGN="LEFT"/>+ confirmed: bool<BR ALIGN="LEFT"/>+ created_at: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ progressPercent(): int<BR ALIGN="LEFT"/>+ isCompleted(): bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Donation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><I>«abstract»</I><BR/><B>Donation</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ user_id: ObjectId<BR ALIGN="LEFT"/>+ campaign_id: ObjectId<BR ALIGN="LEFT"/>+ donation_type: String<BR ALIGN="LEFT"/>+ date_posted: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
FundDonation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>FundDonation</B></TD></TR><TR><TD ALIGN="LEFT">+ amount_cents: int<BR ALIGN="LEFT"/>+ checkout_session_id: String<BR ALIGN="LEFT"/>+ payout_status: String<BR ALIGN="LEFT"/>+ payout_batch_id: ObjectId<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
EquipmentDonation [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>EquipmentDonation</B></TD></TR><TR><TD ALIGN="LEFT">+ item: String<BR ALIGN="LEFT"/>+ quantity: int<BR ALIGN="LEFT"/>+ courier: String<BR ALIGN="LEFT"/>+ tracking_no: String<BR ALIGN="LEFT"/>+ note: String<BR ALIGN="LEFT"/>+ proof_id: ObjectId<BR ALIGN="LEFT"/>+ status: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ markReceived()<BR ALIGN="LEFT"/>+ markRejected()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Comment [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Comment</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ campaign_id: ObjectId<BR ALIGN="LEFT"/>+ user_id: ObjectId<BR ALIGN="LEFT"/>+ comment: String<BR ALIGN="LEFT"/>+ donation_amount: String<BR ALIGN="LEFT"/>+ date_posted: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Payout [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Payout</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ ngo_email: String<BR ALIGN="LEFT"/>+ stripe_account_id: String<BR ALIGN="LEFT"/>+ amount_cents: int<BR ALIGN="LEFT"/>+ currency: String<BR ALIGN="LEFT"/>+ donation_ids: List<BR ALIGN="LEFT"/>+ status: String<BR ALIGN="LEFT"/>+ created_at: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
RewardSettings [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>RewardSettings</B></TD></TR><TR><TD ALIGN="LEFT">+ equipment_credit_cents: int<BR ALIGN="LEFT"/>+ tiers: List&lt;Tier&gt;<BR ALIGN="LEFT"/>+ perks: List&lt;Perk&gt;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ save()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Tier [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Tier</B></TD></TR><TR><TD ALIGN="LEFT">+ key: String<BR ALIGN="LEFT"/>+ name: String<BR ALIGN="LEFT"/>+ min_cents: int<BR ALIGN="LEFT"/>+ blurb: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
Perk [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Perk</B></TD></TR><TR><TD ALIGN="LEFT">+ id: String<BR ALIGN="LEFT"/>+ tier: String<BR ALIGN="LEFT"/>+ type: String<BR ALIGN="LEFT"/>+ limit: String<BR ALIGN="LEFT"/>+ title: String<BR ALIGN="LEFT"/>+ active: bool<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
RewardClaim [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>RewardClaim</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ user_id: ObjectId<BR ALIGN="LEFT"/>+ perk_id: String<BR ALIGN="LEFT"/>+ tier_key: String<BR ALIGN="LEFT"/>+ period: String<BR ALIGN="LEFT"/>+ status: String<BR ALIGN="LEFT"/>+ claimed_at: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ fulfil()<BR ALIGN="LEFT"/>+ decline()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Update [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>Update</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ kind: String<BR ALIGN="LEFT"/>+ category: String<BR ALIGN="LEFT"/>+ title: String<BR ALIGN="LEFT"/>+ body: String<BR ALIGN="LEFT"/>+ sender_id: ObjectId<BR ALIGN="LEFT"/>+ recipients: List<BR ALIGN="LEFT"/>+ created_at: Date<BR ALIGN="LEFT"/>+ expires_at: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ send()<BR ALIGN="LEFT"/>+ retract()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
UpdateState [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>UpdateState</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ read_upto: Date<BR ALIGN="LEFT"/>+ read: List<BR ALIGN="LEFT"/>+ unread: List<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT">+ markRead(update)<BR ALIGN="LEFT"/>+ markAllRead()<BR ALIGN="LEFT"/>+ undoMarkAll()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AuditLog [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#333333"><TR><TD BGCOLOR="#F2F2F2"><B>AuditLog</B></TD></TR><TR><TD ALIGN="LEFT">+ _id: ObjectId<BR ALIGN="LEFT"/>+ user_id: ObjectId<BR ALIGN="LEFT"/>+ role: String<BR ALIGN="LEFT"/>+ action: String<BR ALIGN="LEFT"/>+ changes: String<BR ALIGN="LEFT"/>+ target_user_id: ObjectId<BR ALIGN="LEFT"/>+ timestamp: Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
{rank=same; NGO; Admin; Donor;}
User -> AuditLog [label=" generates ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
User -> UpdateState [label=" read state ", taillabel="1", headlabel="0..1", arrowtail=none, arrowhead=vee, dir=both ];
User -> Update [label=" sends / receives ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
Admin -> NGO [label=" registers ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
NGO -> Campaign [label=" creates ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
Donor -> Donation [label=" makes ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
Campaign -> Donation [label=" receives ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
Campaign -> Comment [label=" has ", taillabel="1", headlabel="0..*", arrowtail=diamond, arrowhead=none, dir=both ];
Donor -> Comment [label=" posts ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
NGO -> Payout [label=" claims ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
Payout -> FundDonation [label=" bundles ", taillabel="1", headlabel="1..*", arrowtail=odiamond, arrowhead=none, dir=both ];
RewardSettings -> Tier [label="  ", taillabel="1", headlabel="1..*", arrowtail=diamond, arrowhead=none, dir=both ];
RewardSettings -> Perk [label="  ", taillabel="1", headlabel="0..*", arrowtail=diamond, arrowhead=none, dir=both ];
Perk -> Tier [label=" unlocked at ", taillabel="0..*", headlabel="1", arrowtail=none, arrowhead=vee, dir=both , constraint=false];
Donor -> RewardClaim [label=" submits ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
RewardClaim -> Perk [label=" for ", taillabel="0..*", headlabel="1", arrowtail=none, arrowhead=vee, dir=both ];
Admin -> RewardClaim [label=" handles ", taillabel="1", headlabel="0..*", arrowtail=none, arrowhead=vee, dir=both ];
edge [dir=back];
User -> Donor [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.3];
User -> NGO [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.3];
User -> Admin [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.3];
Donation -> FundDonation [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.3];
Donation -> EquipmentDonation [dir=back, arrowtail=empty, arrowsize=1.3, penwidth=1.3];
}
